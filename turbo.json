{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**", ".next/**", "build/**", ".vercel/**"],
      "env": [
        "DB_URL",
        "JWT_SECRET",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_UPLOAD_PRESET",
        "RESEND_API_KEY"
      ]
    },
    "lint": {},
    "typecheck": {},
    "db:migrate": {
      "cache": false
    }
  }
}
