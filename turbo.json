{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "dist/**", ".next/**", "build/**"]
    },
    "lint": {},
    "typecheck": {},
    "db:migrate": {
      "cache": false
    }
  }
}
