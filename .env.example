# Mobile app (Expo) — point at local SvelteKit dev server
# Local development
EXPO_PUBLIC_API_URL=http://localhost:5173/api

# Production — set after Railway deploy
# EXPO_PUBLIC_API_URL=https://your-app.up.railway.app/api

# Image uploads go through the API (server uses Cloudinary API key/secret).
# No mobile upload preset required.

# Web app — copy to apps/web/.env
# DB_URL=postgresql://user:pass@host/db
# JWT_SECRET=your-secret-min-32-chars
# RESEND_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
